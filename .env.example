# Copie este arquivo para .env e ajuste os valores.
# Em desenvolvimento, nada aqui é obrigatório: o projeto roda com os padrões.

# Chave usada pelo Django para assinar sessões e tokens.
# Em produção, gere uma própria:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 em desenvolvimento, 0 em produção.
DJANGO_DEBUG=1

# Domínios que podem servir a aplicação, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Endereços confiáveis para formulários (use https:// em produção).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000

# Envio de e-mail. Em desenvolvimento as mensagens aparecem no terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
