@startuml
title Classes de Análise - Plataforma de Agendamento Multidisciplinar

class Usuario {
    +id: int
    +email: string
    +nome: string
    +telefone: string
}

class Cliente

class Profissional {
    +especialidade: string
    +modalidade: string
    +formacao: text
    +apresentacao: text
}

class Servico {
    +id: int
    +nome: string
    +tipo: string
    +duracao_minutos: int
}

class Agendamento {
    +id: int
    +data_hora_inicio: datetime
    +data_hora_fim: datetime
    +status: string
    +motivos_conflito(): List<string>
    +verificar_conflito(): boolean
}

Usuario <|-- Cliente
Usuario <|-- Profissional
Profissional "1" -- "0..*" Servico : oferece
Cliente "1" -- "0..*" Agendamento : realiza
Profissional "1" -- "0..*" Agendamento : atende
Servico "1" -- "0..*" Agendamento : é utilizado em

@enduml
